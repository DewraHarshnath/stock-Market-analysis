# Copy this file to ".env" in the same folder before running the app.

# Which data source to use: yfinance | alpha_vantage | generic_broker
DATA_PROVIDER=yfinance

# Only needed if DATA_PROVIDER=alpha_vantage
ALPHA_VANTAGE_API_KEY=

# Only needed if DATA_PROVIDER=generic_broker (Zerodha/Upstox/Angel One/etc.)
BROKER_BASE_URL=
BROKER_API_KEY=
BROKER_ACCESS_TOKEN=
